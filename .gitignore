# dependências e saída do build
node_modules/
dist/

# notas internas, rascunhos e prints (ficam só no computador)
_interno/
.preview/
.snapshots/
.verdicts/
progress/
referencias/
referencias-crops/
docs/
.claude/
*.md
!.github/**/*.md

# Worker da roleta: fica num repositório privado separado
worker/
roda-api/

# ferramentas de teste locais (o site só precisa de build, serve e strip)
tools/*
!tools/build.mjs
!tools/serve.mjs
!tools/strip.mjs

# hospedagem antiga (Vercel), não usada no GitHub Pages
vercel.json
api/

# imagens originais grandes (as versões leves ficam em assets/img)
assets/originais/
assets/streamers/
assets/*.png
assets/*.jpg

# segredos e variáveis locais: nunca subir
.env
.env.*
.dev.vars
.dev.vars.*
*.pem
*.key
.wrangler/

# mapas de código, backups e rascunhos
*.map
*.bak
*.orig
*.tmp
*~
*.rascunho.*

# sistema
.DS_Store
Thumbs.db
desktop.ini
*.log
